/target
packages/app/api/target/
packages/app/api/gen/
Cargo.lock.bak
*.pdb

# ===== Python (regenerados) =====
.venv/
__pycache__/
.pytest_cache/

# ===== Objetos soltos de build (legado/regeneráveis) =====
*.o
*.obj

# ===== Gerados por build_proxy.py (regenerar: uv run python analysis/build_proxy.py)
analysis/forwarders_impl.c
analysis/midi_proxy_build.c
analysis/winmm.dll

# ===== Material de origem NÃO distribuído (README §7 - nota legal) =====
# Instaladores, firmware, driver, manual, tool de debug, imagens, logs.
# EXCEÇÕES versionadas: files/patches/*.prst (gate de regressão/round-trip M0.2)
# e o briefing original.
files/*
!files/patches/
!files/prompt_inicial.md

# Extrações de instaladores/driver (não distribuir - README §7) e cópia do Suite
analysis/nsis_app/
analysis/suite_local/
analysis/driver_ext/

# Dumps de strings/texto DERIVADOS de material proprietário (regeneráveis
# a partir de files/app e firmware, que ficam só locais)
analysis/exe_strings.txt
analysis/fw_strings.txt
analysis/manual_streams.txt
analysis/manual_decoded.txt
# Manual oficial (documento proprietário da Valeton - README §7): o PDF e a
# transcrição NÃO são distribuídos; os scripts de extração e a NOTA de
# revisão (analysis/notes/) ficam versionados.
analysis/manual_v18.pdf
analysis/manual_v18.txt

# Estado interno do cliente Freebuff
.freebuff/

# Import libraries de build (legado/regeneráveis)
*.lib

# Kit de campo H1: ensaios e saídas de campo são DESCARTÁVEIS (o que preserva
# evidência é analysis/captures/sessionH1.jsonl + docs/H1_REPORT.md; as
# referências do mock ficam em analysis/h1_reference/ — versionadas)
analysis/h1_rehearsal_*/
analysis/h1_field_*/

# Kit de campo H2 (#22): mesma regra do H1. O que PRESERVA a evidência da
# escrita e a sessao em analysis/h2/<nome>/ (que o .gitattributes marca
# `-text`, porque e a unica prova de que o preset do dono foi gravado — o fio
# nao tem read-back, D3/D4). Ensaio e saida descartavel; a referencia que
# ancora a tabela de formas do juiz (analysis/h2_reference/) fica versionada.
analysis/h2_rehearsal_*/
analysis/h2_scratch*/
analysis/h2_scratch_test/

# ── Front (packages/app/ui/, M1.0+) ──
packages/app/ui/node_modules/
packages/app/ui/dist/
packages/app/ui/coverage/
# Saídas do Playwright (nascem na falha do e2e; nunca versionar). Já cobertas
# por packages/app/ui/.gitignore dentro do pacote; a raiz aqui é defesa para
# quem rodar a suíte de fora — #144 (F-08).
packages/app/ui/test-results/
packages/app/ui/playwright-report/
# Saídas de teste fora do pacote do front (nasceram do rodar de fora; #159).
packages/test-results/
# Log de fio do app de campo (transaction log local; o evidência versionada é
# analysis/h2/ e docs/H2_REPORT.md — o log de UMA execução não é artefato).
packages/app/api/*.jsonl
packages/app/api/wire-*.jsonl
*.tsbuildinfo
# Spec/plano de execucao de issue (#155): registro LOCAL, nao artefato publico.
docs/superpowers/

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GP-100 NextGen Editor",
  "mainBinaryName": "gp100-nextgen-editor",
  "version": "0.2.0-rc.4",
  "identifier": "com.gp100.nextgen.editor",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GP-100 NextGen Editor",
        "width": 1024,
        "height": 640,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Editor do pedal GP-100 (NextGen)",
    "longDescription": "Editor de presets e parâmetros da pedaleira Valeton GP-100, com upload de IR e controle ao vivo.",
    "copyright": "",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/doc/gp100-nextgen-editor/README.md": "../../../README.md"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "language": ["pt-BR", "en-US"]
      }
    }
  }
}

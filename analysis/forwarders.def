// forwarders.c — lazy stubs included into midi_proxy.c build via #include
// (kept as separate file only for readability; concatenated by build script)
// Each stub resolves the real function on first call.

#define STUB(ret, name, args, params) \
    __attribute__((used)) ret WINAPI stub_##name args { \
        static FARPROC fn = NULL; \
        if (!fn) fn = resolve(#name); \
        return ((ret (WINAPI*)args)fn) params; \
    }


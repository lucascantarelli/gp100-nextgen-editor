{
  // Rust: o rustfmt do editor usa a toolchain do rust-toolchain.toml (gnu
  // na raiz; MSVC em src-tauri tem o próprio). rust-analyzer nos dois
  // workspaces (raiz = core/cli; src-tauri = workspace próprio).
  "rust-analyzer.linkedProjects": [
    "Cargo.toml",
    "packages/app/api/Cargo.toml"
  ],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--all-targets"],
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  // Front: ESLint 10 flat config com regras do ui/ (tokens, R1 no ipc).
  "eslint.workingDirectories": [{ "pattern": "packages/app/ui/" }],
  "eslint.useFlatConfig": true,
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "typescript.tsdk": "packages/app/ui/node_modules/typescript/lib",
  "files.exclude": {
    "packages/app/ui/dist": true,
    "packages/app/api/target": true,
    "target": true
  },
  "files.associations": {
    "*.prst": "xml"
  },
  "search.exclude": {
    "**/target": true,
    "packages/app/ui/dist": true,
    "analysis/nsis_app": true,
    "pnpm-lock.yaml": true,
    "Cargo.lock": true
  }
}

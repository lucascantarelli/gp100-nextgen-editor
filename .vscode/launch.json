{
  // Debug do GP-100 NextGen Editor.
  //
  // COMO VER A UI (owner, escolha pelo objetivo):
  //  1. Visual rápido (sem shell nativo): rode a task "ui: dev server" e
  //     abra http://localhost:5173 no browser — o ipc tem fallback mock
  //     (mesmos valores do MockDevice) e o boot mostra a barra com
  //     progresso sintético. Launch "UI (Chrome)" faz isso com F5.
  //  2. Janela desktop real: launch "Tauri (dev)" — sobe o shell WebView2
  //     + vite. REQUER MSVC no host (rustup toolchain install
  //     stable-x86_64-pc-windows-msvc + VS Build Tools; ADR-7). Sem MSVC,
  //     a janela nativa não compila — use a opção 1 ou a CI.
  //  3. Depurar o backend Rust dentro do shell nativo: launch "Tauri
  //     (backend C++/Rust attach)" após iniciar o tauri dev.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UI (Chrome) — vite dev + mock",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/ui/src",
      "preLaunchTask": "ui: dev server (vite — UI no browser)",
      "runtimeArgs": ["--auto-open-devtools-for-tabs"]
    },
    {
      "name": "UI (Edge) — vite dev + mock",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/ui/src",
      "preLaunchTask": "ui: dev server (vite — UI no browser)"
    },
    {
      "name": "Tauri (dev) — janela desktop real",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/ui/node_modules/.bin/tauri.cmd",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/src-tauri",
      "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "windows": { "runtimeExecutable": "${workspaceFolder}/ui/node_modules/.bin/tauri.cmd" }
    },
    {
      "name": "Rust — debug gp100-cli (args do device)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/gp100-cli.exe",
      "args": ["info"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "rust: core+cli — fmt/clippy/test (toolchain gnu da raiz)"
    },
    {
      "name": "Vitest — debug arquivo atual",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/ui/node_modules/.bin/vitest.cmd",
      "args": ["run", "${relativeFile}", "--no-file-parallelism"],
      "cwd": "${workspaceFolder}/ui",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "UI + backend (tauri dev com watch do front)",
      "configurations": ["Tauri (dev) — janela desktop real"],
      "stopAll": true
    }
  ]
}

{
  // Tasks do GP-100 NextGen Editor (Windows + Git Bash do host, gnu pinado
  // na raiz — ADR-7/ADR-8: o shell do Tauri usa MSVC explícito).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "app/ui: dev server (vite — UI-only, sem aparelho)",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}/packages/app/ui" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "http://localhost:5173 — UI-ONLY: no navegador não há IPC do Tauri (o aparelho é inalcançável por construção). O front usa o fallback de DEV/TESTE e o badge 'Mock Device' declara isso. Para o aparelho, use a task tauri: dev (#165)."
    },
    {
      "label": "app/ui: build (tsc + vite)",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}/packages/app/ui" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "app/ui: testes (vitest run)",
      "type": "shell",
      "command": "pnpm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/packages/app/ui" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "app/ui: lint (eslint)",
      "type": "shell",
      "command": "pnpm",
      "args": ["lint"],
      "options": { "cwd": "${workspaceFolder}/packages/app/ui" },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "app/ui: watch testes (vitest)",
      "type": "shell",
      "command": "pnpm",
      "args": ["test:watch"],
      "options": { "cwd": "${workspaceFolder}/packages/app/ui" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "rust: core+cli — fmt/clippy/test (toolchain gnu da raiz)",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace"],
      "options": { "cwd": "${workspaceFolder}", "env": {} },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "rust: gp100-ui — clippy (MSVC da api)",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "-p", "gp100-ui", "--all-targets", "--", "-D", "warnings"],
      "options": {
        "cwd": "${workspaceFolder}/packages/app/api",
        // ADR-7: o crate do Tauri exige MSVC; o host não tem VS Build Tools
        // — esta task só funciona APÓS instalar MSVC (ver ADR-7/launch.json).
        "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" }
      },
      "problemMatcher": ["$rustc"],
      "detail": "Requer VS Build Tools (MSVC) no host — sem eles, use a CI/preview browser."
    },
    {
      "label": "rust: gp100-ui — check SEM transporte (--no-default-features)",
      "type": "shell",
      "command": "cargo",
      "args": ["check", "-p", "gp100-ui", "--no-default-features", "--all-targets"],
      "options": {
        "cwd": "${workspaceFolder}/packages/app/api",
        "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" }
      },
      "problemMatcher": ["$rustc"],
      "detail": "O app sem transporte nenhum (backend Desligado por compilação) — caminho de teste do default invertido (#165)."
    },
    {
      "label": "tauri: dev — aparelho (default)",
      "type": "shell",
      "command": "${workspaceFolder}/packages/app/ui/node_modules/.bin/tauri.cmd",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}/packages/app/api",
        "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "DEFAULT (#165): janela nativa com o RealDevice ligado (feature default do crate). Requer MSVC no host (ADR-7) e o GP-100 na USB para o device_info responder real."
    },
    {
      "label": "cli: build de campo (real-device)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--release", "-p", "gp100-cli", "--features", "real-device"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "detail": "Binário de campo gnu: target/release/gp100-cli.exe (--real --i-know-what-im-doing; mock de teste: --mock-device)"
    }
  ]
}

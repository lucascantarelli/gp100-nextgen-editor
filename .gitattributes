# Normaliza finais de linha: LF no repo e no checkout (evita avisos CRLF no Windows)
* text=auto eol=lf

# Binários (sem normalizacao)
*.bin binary
*.wav binary
*.png binary
*.dll binary
*.pdf binary

# Especificação executável: BYTES CONGELADOS — o hash da baseline (PROTOCOL.md §13)
# cobre os EOLs; -text impede qualquer conversão, no disco e no checkout.
docs/protocol_golden.json -text

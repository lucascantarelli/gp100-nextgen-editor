# Normaliza finais de linha: LF no repo e no checkout (evita avisos CRLF no Windows)
* text=auto eol=lf

# Binários (sem normalizacao)
*.bin binary
*.wav binary
*.png binary
*.dll binary
*.pdf binary

# Especificação executável e patches de referência: BYTES CONGELADOS — o
# round-trip byte-idêntico (R4) e o hash da baseline (§13) cobrem os EOLs;
# -text impede qualquer conversão, no disco e no checkout.
docs/protocol_golden.json -text
files/patches/*.prst -text

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GP-100 NextGen Editor",
  "version": "0.1.0",
  "identifier": "com.gp100.nextgen.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GP-100 NextGen Editor",
        "width": 1024,
        "height": 640,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
